#cloud-config
# See the autoinstall documentation at:
# https://canonical-subiquity.readthedocs-hosted.com/en/latest/reference/autoinstall-reference.html
autoinstall:
  version: 1
  refresh-installer:
    update: true
    channel: stable/ubuntu-$REL
  source:
    search_drivers: false
    id: ubuntu-server-minimal
  kernel:
    package: linux-generic
  codecs:
    install: false
  drivers:
    install: false
  oem:
    install: false
  apt:
    preserve_sources_list: false
    fallback: offline-install
    geoip: true
    mirror-selection:
      primary:
      - country-mirror
      - arches: &id001
        - amd64
        - i386
        uri: http://archive.ubuntu.com/ubuntu/
      - arches: &id002
        - s390x
        - arm64
        - armhf
        - powerpc
        - ppc64el
        - riscv64
        uri: http://ports.ubuntu.com/ubuntu-ports
    security:
    - arches: *id001
      uri: http://security.ubuntu.com/ubuntu/
    - arches: *id002
      uri: http://ports.ubuntu.com/ubuntu-ports
  updates: all
  storage:
    version: 1
    config:
      - type: disk
        id: default-disk
        match:
          ssd: true
          size: largest
        ptable: gpt
        wipe: superblock-recursive
        preserve: false
        grub_device: true
        name: system
      - type: partition
        number: 1
        id: boot-partition
        device: default-disk
        size: 1G
        flag: bios_grub
        name: boot-partition
        partition_name: boot-partition
        wipe: superblock
        preserve: false
      - type: partition
        number: 2
        id: root-partition
        device: default-disk
        size: -1
        name: root-partition
        partition_name: root-partition
        wipe: superblock
        preserve: false
      - type: format
        id: root-format
        fstype: ext4
        volume: root-partition
        preserve: false
        label: system
      - type: mount
        id: root-mount
        device: root-format
        path: /
  network:
    version: 2
    ethernets:
      nic:
        match:
          name: en*
        dhcp4: true
  hostname: dev-server
  create_hostname_file: true
  ssh:
    install-server: true
    allow-pw: true
  locale: en_US.UTF-8
  keyboard:
    layout: us
  timezone: America/Toronto
  user-data:
    groups:
      - docker
    users:
      - name: thomas
        gecos: Thomas Gohard
        primary_group: thomas
        groups: thomas, adm, docker, plugdev, sudo
        shell: /bin/bash
        passwd: [insert password here]
        lock_passwd: false
  shutdown: reboot
